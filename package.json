{
  "name": "aitalk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/node.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/server/node.ts",
    "typecheck": "tsc --noEmit",
    "deploy:cf": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "tsx": "^4.20.6",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  }
}
