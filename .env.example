# ---------------------------------------------------------------------------
# Server-side only. NEVER prefix anything here with VITE_ — Vite inlines VITE_*
# into the browser bundle, which would publish the value to every visitor.
# ---------------------------------------------------------------------------

# Claude API key. Leave empty to run with canned mock tutor replies.
ANTHROPIC_API_KEY=

# --- Google sign-in (required; the app has no anonymous mode) ---------------
# Create at https://console.cloud.google.com/apis/credentials
#   → Create credentials → OAuth client ID → Web application
#   → Authorized redirect URI: <APP_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Who may sign in, comma separated, case-insensitive.
# Google itself lets ANY Google account through for the scopes this app requests,
# so this list is the only thing restricting access. Empty means nobody.
ALLOWED_EMAILS=you@example.com

# Public origin. Optional on Railway: when a domain has been generated, this is
# derived from RAILWAY_PUBLIC_DOMAIN automatically. Set it only for a custom
# domain, or locally. Must match the redirect URI registered with Google exactly.
APP_URL=http://localhost:3000

# --- Unit lecture videos (optional) -----------------------------------------
# Enables the automatic YouTube search that finds a supporting video for each
# unit's opening lecture. Create it in the same Google Cloud project:
#   APIs & Services -> Enable APIs -> YouTube Data API v3 -> Create credentials
# Without it the lectures still work; they just show slides only.
#
# Note the default allowance is 100 searches per DAY, so results are cached in
# the database per unit and reused. Delete a row from unit_videos to re-search.
YOUTUBE_API_KEY=

# --- Database ---------------------------------------------------------------
# Railway injects this when you add a Postgres service to the project.
# Leave empty locally to run without server-side progress (it stays on-device).
DATABASE_URL=

PORT=3000
