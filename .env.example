# Server-side only. NEVER prefix with VITE_ — Vite inlines VITE_* into the browser bundle.
# Leave empty to run the whole app in mock mode (no AI calls, no key needed).
ANTHROPIC_API_KEY=

# Port for the Node/Railway entry. Railway injects its own PORT.
PORT=3000

# Optional. When set, every /api/tutor and /api/coach call must send
# the header `x-aitalk-pass` with this value. Recommended for any public deploy.
DEMO_PASSCODE=
